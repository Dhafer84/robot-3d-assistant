# Clé API Groq (https://console.groq.com/keys)
GROQ_API_KEY=ta_cle_groq_ici

# Modèle Groq utilisé pour les réponses
GROQ_MODEL=openai/gpt-oss-20b

# Port du serveur (frontend + API)
PORT=3000

# Voix naturelle Piper (facultatif, voir tts/README.md)
# Voix : "modele" ou "modele:numero_de_locuteur"
TTS_VOICE_FR=fr_FR-upmc-medium:1
TTS_VOICE_EN=en_US-ryan-high
# Vitesse : 1.0 = normale, 1.1 = 10 % plus rapide
TTS_SPEED=1.0
TTS_PORT=5005
