# Clé API Groq (https://console.groq.com/keys)
GROQ_API_KEY=ta_cle_groq_ici

# Modèle Groq utilisé pour les réponses
GROQ_MODEL=openai/gpt-oss-20b
# Modèles de secours (séparés par des virgules), utilisés quand le précédent a atteint sa
# limite : chaque modèle a son propre quota gratuit (200 000 tokens/jour ≈ 80 questions)
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# Port du serveur (frontend + API)
PORT=3000
# Adresse d'écoute : 127.0.0.1 (local, derrière Nginx) ; 0.0.0.0 pour l'ouvrir sur le réseau
HOST=127.0.0.1

# Voix naturelle Piper (facultatif, voir tts/README.md)
# Voix : "modele" ou "modele:numero_de_locuteur"
TTS_VOICE_FR=fr_FR-tom-medium
TTS_VOICE_EN=en_US-ryan-high
# Vitesse : 1.0 = normale, 1.1 = 10 % plus rapide
TTS_SPEED=1.0
TTS_PORT=5005

# Limites par visiteur (requêtes par minute et par adresse IP)
CHAT_LIMIT_PER_MINUTE=10
TTS_LIMIT_PER_MINUTE=60

# Sites autorisés à afficher l'assistant dans une bulle (origines HTTPS séparées par des espaces)
FRAME_ANCESTORS=https://qualitycrew.fr https://www.qualitycrew.fr
